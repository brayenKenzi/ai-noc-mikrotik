# ==========================================================
# KONFIGURASI AI NOC MULTI-MIKROTIK (UBAH SESUAI LINGKUNGAN)
# ==========================================================

# Port Web UI + API + WebSocket (default 8090 agar bebas bentrok dengan 8080/3000)
PORT=8090
SYSLOG_UDP_PORT=5514

# IP Server AI NOC (dilindungi oleh Anti-Lockout Guardrail agar tidak pernah terblokir AI)
NOC_SERVER_IP=192.168.88.10

# Interval polling telemetri RouterOS dalam milidetik (default 15 detik)
POLL_INTERVAL_MS=15000

# Akun login Admin Web Kantor AI NOC (bisa diubah lagi dari GUI setelah login)
NOC_ADMIN_USER=admin
NOC_ADMIN_PASS=ganti_dengan_password_admin_noc

# Token API opsional untuk integrasi skrip/webhook
NOC_ADMIN_TOKEN=

# --- Kredensial Akun MikroTik (RBAC Terpisah: Read-Only vs Executor) ---
MT_READ_SECRET=ganti_dengan_secret_readonly_mikrotik
MT_EXEC_SECRET=ganti_dengan_secret_executor_mikrotik

# --- Cloud LLM API (Pilih salah satu: Gemini API ATAU OpenAI/DeepSeek Compatible) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatif jika memakai DeepSeek / OpenAI:
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Telegram Bot Approval Notification (Opsional namun direkomendasikan) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
